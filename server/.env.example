# All values are optional in development; the defaults below are used when unset.
# In production (NODE_ENV=production) JWT_SECRET, DEMOPAY_KEY_SECRET and DEMOPAY_WEBHOOK_SECRET must be set.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27027/storefront?replicaSet=rs0
APP_ORIGIN=http://localhost:5173

# At least 32 characters. Signs access tokens.
JWT_SECRET=

# Simulated payment gateway
DEMOPAY_KEY_ID=demopay_test_key
DEMOPAY_KEY_SECRET=
DEMOPAY_WEBHOOK_SECRET=
# DEMOPAY_WEBHOOK_URL=http://127.0.0.1:4000/api/v1/webhooks/demopay

# Demo inbox page and automatic demo data on an empty database
DEMO_MODE=true
AUTO_SEED=true
RUN_JOBS=true

# Where uploaded images are stored (default: <repo>/.data/uploads)
# UPLOAD_DIR=

# Serve the built client (npm run build) from the API on one port
SERVE_CLIENT=false
# Number of reverse proxies in front of the API (for correct client IPs in rate limits)
TRUST_PROXY=0
LOG_LEVEL=info
